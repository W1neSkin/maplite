{
  "name": "@cartography/server",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:better-sqlite3",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli.ts migrate",
    "db:verify": "tsx --env-file-if-exists=../../.env src/cli.ts verify",
    "test": "vitest run"
  },
  "dependencies": {
    "@cartography/project-schema": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}

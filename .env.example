# Server
PORT=3847
DATABASE_PATH=./data/cartography.sqlite
PUBLIC_BASE_URL=http://127.0.0.1:3847
# At least 256 bits of randomness. Leave empty in development and the server
# writes a generated token to data/dev-credentials.json (not in production).
ADMIN_TOKEN=
CORS_ORIGINS=http://127.0.0.1:3848,http://localhost:3848,https://localhost,capacitor://localhost
BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_PROXY=true
MAX_IMPORT_BYTES=52428800
MAX_FEATURES_PER_IMPORT=5000
MAX_VERTICES_PER_IMPORT=200000
POSITION_HISTORY_LIMIT=40
TRACK_RETENTION_DAYS=30
DEMO_LIVE_STREAM=false
SEED_DEMO=true
# Writes data/dev-credentials.json so a local browser can be connected.
# Set to false in any shared or production deployment.
ALLOW_DEV_CREDENTIALS_FILE=true

# Optional push. The server runs without these and reports pushCommands: false.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=

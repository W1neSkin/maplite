{
  "name": "cartographic-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Shared cartographic workspace for browser, Android, and iOS.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cartography/server --filter @cartography/client dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && node scripts/check-boundaries.mjs && node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "mobile:sync": "pnpm --filter @cartography/client build && pnpm --filter @cartography/mobile sync",
    "android:build": "bash scripts/ci/android.sh",
    "ios:prepare": "pnpm --filter @cartography/mobile prepare:ios",
    "db:migrate": "pnpm --filter @cartography/server db:migrate",
    "db:verify": "pnpm --filter @cartography/server db:verify",
    "api:generate": "pnpm --filter @cartography/project-schema api:generate",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
